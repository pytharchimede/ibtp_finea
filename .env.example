# Variables d'environnement du serveur (aucune valeur secrète dans Git)
APP_ENV=local
APP_URL=http://localhost/ibtp_finea
# Laisser vide pour une installation à la racine ; sinon /nom-du-dossier
APP_BASE_PATH=/ibtp_finea
FINEA_BRAND_PROFILE=ibtp
FINEA_MODULE_PROFILE=ibtp
# Copier ce fichier en .env (non versionné) et renseigner les valeurs locales.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=finea_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
# Fournir ces deux valeurs uniquement lors de la première installation :
# FINEA_BOOTSTRAP_ADMIN_EMAIL=adresse_admin_client
# FINEA_BOOTSTRAP_ADMIN_PASSWORD=mot_de_passe_unique_de_12_caracteres_minimum
